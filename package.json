    },
    "./trusted-action-port": {
      "types": "./src/trusted-action-port.d.mts",
      "default": "./src/trusted-action-port.mjs"
    },
    "./memory-continuity": {
      "types": "./src/memory-continuity.d.mts",
      "default": "./src/memory-continuity.mjs"
    },
    "./policy-action": {
      "types": "./src/policy-action.d.mts",
      "default": "./src/policy-action.mjs"
    }
  },
  "scripts": {
    "test": "node --test",
    "demo": "node examples/synthetic-agent.mjs",
    "demo:model-swap": "node examples/provider-swap.mjs",
    "demo:two-agents": "node examples/two-independent-agents.mjs"
  },
  "types": "./src/index.d.mts"
}

{
  "name": "ginger-tail",
  "version": "0.1.0",
  "description": "A local-first runtime for persistent autonomous AI identities",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./history-context": "./src/history-context.mjs",
    "./attention-core": "./src/attention-core.mjs",
    "./thought-core": "./src/thought-core.mjs",
    "./contracts": {
      "types": "./src/contracts.d.mts",
      "default": "./src/contracts.mjs"
    },
    "./cognition-control": {
      "types": "./src/cognition-control.d.mts",
      "default": "./src/cognition-control.mjs"
    },
    "./cognition-journey": {
      "types": "./src/cognition-journey.d.mts",
      "default": "./src/cognition-journey.mjs"
    },
    "./action-outcomes": {
      "types": "./src/action-outcomes.d.mts",
      "default": "./src/action-outcomes.mjs"
    },
    "./decision-dispatch": {
      "types": "./src/decision-dispatch.d.mts",
      "default": "./src/decision-dispatch.mjs"
    },
    "./model-port": {
      "types": "./src/model-port.d.mts",
      "default": "./src/model-port.mjs"
    },
    "./world-read-port": {
      "types": "./src/world-read-port.d.mts",
